@page
@model RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Skapa konto - ZipTrip</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
            if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
    </script>
    <style>
            .dark input[type="date"]::-webkit-calendar-picker-indicator {
                filter: invert(1);
                opacity: 0.5;
            }
    </style>
</head>
<body class="bg-background text-foreground min-h-screen font-sans">
    <div class="min-h-screen flex flex-col items-center justify-center p-4 py-10">
        
        <div class="w-full max-w-[420px]">

            <a href="/" class="flex items-center gap-2 text-foreground/60 hover:text-foreground mb-8 transition-colors w-fit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
                <span class="text-sm">Tillbaka</span>
            </a>

            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-primary flex items-center justify-center">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0f1219" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                </div>
                <span class="text-3xl font-bold text-primary tracking-tight">ZipTrip</span>
            </div>

            <div class="bg-card border border-border rounded-2xl p-8 shadow-2xl">
                <h1 class="text-2xl font-bold mb-2">Skapa konto</h1>
                <p class="text-foreground/60 text-sm mb-6">Registrera dig och börja planera din nästa resa.</p>

                <form method="post" class="space-y-4">
                    <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs"></div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium">Förnamn</label>
                            <input asp-for="Input.FirstName" class="w-full h-11 bg-background border border-border rounded-lg px-3 text-sm focus:border-primary focus:outline-none transition-colors" placeholder="Förnamn" />
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium">Efternamn</label>
                            <input asp-for="Input.LastName" class="w-full h-11 bg-background border border-border rounded-lg px-3 text-sm focus:border-primary focus:outline-none transition-colors" placeholder="Efternamn" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-medium">E-postadress</label>
                        <div class="relative flex items-center">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 text-foreground/50"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                            <input asp-for="Input.Email" class="w-full h-11 bg-background border border-border rounded-lg pl-10 pr-4 text-sm focus:border-primary focus:outline-none transition-colors" placeholder="din@email.se" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-medium">Födelsedatum</label>
                        <input asp-for="Input.DateOfBirth" type="date" class="w-full h-11 bg-background border border-border rounded-lg px-3 text-sm focus:border-primary focus:outline-none transition-colors text-foreground/80" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-2">
                            <label class="block text-sm font-medium">Lösenord</label>
                            <input asp-for="Input.Password" type="password" class="w-full h-11 bg-background border border-border rounded-lg px-3 text-sm focus:border-primary focus:outline-none transition-colors" placeholder="••••••••" />
                        </div>
                        <div class="space-y-2">
                            <label class="block text-sm font-medium">Bekräfta</label>
                            <input asp-for="Input.ConfirmPassword" type="password" class="w-full h-11 bg-background border border-border rounded-lg px-3 text-sm focus:border-primary focus:outline-none transition-colors" placeholder="••••••••" />
                        </div>
                    </div>

                    <button type="submit" class="w-full h-11 mt-4 bg-primary text-[#0f1219] font-bold rounded-lg hover:brightness-110 transition-all">
                        Skapa konto
                    </button>
                </form>

                <p class="mt-6 text-center text-sm text-foreground/60">
                    Har du redan ett konto? <a asp-page="./Login" class="text-primary font-bold hover:underline">Logga in</a>
                </p>
            </div>
            
        </div>
    </div>
</body>
</html>