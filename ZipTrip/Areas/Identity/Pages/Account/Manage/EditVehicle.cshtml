@page "{id:Guid}" 
@model ZipTrip.Areas.Identity.Pages.Account.Manage.EditVehicleModel
@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="max-w-3xl">
    <div class="mb-8">
        <div class="flex items-center gap-4 mb-2">
            <a href="/Account/Manage/Vehicles" class="text-primary hover:underline text-sm font-bold uppercase tracking-widest">Back to Garage</a>
        </div>
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Edit your car info.</p>
    </div>
    
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="bg-card border border-border rounded-[32px] p-8 md:p-10 shadow-2xl">
        <div class="flex items-center gap-3 mb-8">
            <div class="h-6 w-1 bg-primary rounded-full"></div>
            <h4 class="text-xl font-bold text-foreground">Edit Vehicle Details</h4>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8 opacity-60 pointer-events-none">
            <div class="space-y-1">
                <label class="text-xs font-bold text-foreground/40 uppercase ml-1 tracking-widest">Original Vehicle</label>
                <div class="w-full h-12 bg-foreground/10 rounded-xl px-4 flex items-center text-sm font-mono border border-border/20">
                    @Model.VehicleInfo?.Name
                </div>
            </div>
            <div class="space-y-1">
                <label class="text-xs font-bold text-foreground/40 uppercase ml-1 tracking-widest">Original Year</label>
                <div class="w-full h-12 bg-foreground/10 rounded-xl px-4 flex items-center text-sm font-mono border border-border/20">
                    @Model.VehicleInfo?.Year
                </div>
            </div>
        </div>

        <form method="post" class="space-y-6 pt-6 border-t border-border/20">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs italic"></div>

            <input type="hidden" asp-for="Input.Id" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label asp-for="Input.Name" class="text-sm font-medium ml-1 text-foreground"></label>
                    <input asp-for="Input.Name" id="res-nickname" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 outline-none transition-all" placeholder="ex. My Car" />
                    <span asp-validation-for="Input.Name" class="text-primary text-[10px]"></span>
                </div>
                
                <div class="space-y-1 opacity-60 pointer-events-none">
                    <label asp-for="Input.SelectedVehicleType" class="text-sm font-medium ml-1 text-foreground"></label>
                    <div class="relative">
                        <select asp-for="Input.SelectedVehicleType" asp-items="Html.GetEnumSelectList<ZipTrip.Domain.Enums.VehicleType>()" class="w-full h-12 bg-foreground/10 border-transparent rounded-xl px-4 text-sm outline-none appearance-none"></select>
                        <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-foreground/20">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6" /></svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 opacity-60 pointer-events-none">
                <div class="space-y-1">
                    <label asp-for="Input.MaxHeightMeters" class="text-xs font-bold text-foreground/40 uppercase ml-1"></label>
                    <input asp-for="Input.MaxHeightMeters" type="number" step="0.01" readonly class="w-full h-12 bg-foreground/10 border-transparent rounded-xl px-4 text-sm outline-none" />
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.MaxWeightKg" class="text-xs font-bold text-foreground/40 uppercase ml-1"></label>
                    <input asp-for="Input.MaxWeightKg" type="number" step="1" readonly class="w-full h-12 bg-foreground/10 border-transparent rounded-xl px-4 text-sm outline-none" />
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.RangeKm" class="text-xs font-bold text-foreground/40 uppercase ml-1"></label>
                    <input asp-for="Input.RangeKm" type="number" step="1" readonly class="w-full h-12 bg-foreground/10 border-transparent rounded-xl px-4 text-sm outline-none" />
                </div>
            </div>

            <div class="flex items-center gap-3 px-2 mt-4 cursor-pointer group">
                <div class="relative flex items-center">
                    <input type="checkbox" asp-for="Input.IsDefault"
                           class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-primary/30 bg-foreground/5 checked:bg-primary checked:border-primary transition-all" />
                    <svg class="absolute h-3.5 w-3.5 pointer-events-none hidden peer-checked:block stroke-[#0f1219] left-0.5 top-0.5"
                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <label asp-for="Input.IsDefault" class="text-sm font-bold text-foreground/60 group-hover:text-primary transition-colors cursor-pointer uppercase tracking-widest text-[10px]">
                    Set as primary vehicle
                </label>
            </div>

            <button type="submit" class="w-full py-4 bg-primary text-[#0f1219] font-black rounded-xl hover:opacity-90 hover:scale-[1.01] active:scale-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2 mt-6 uppercase tracking-wider text-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                Save changes
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}