@model ZipTrip.Services.DTOs.Trip.TripResponse
@using System.Text.Json

<div class="flex-1 flex flex-col md:flex-row h-full relative" id="trip-modal-wrapper">
    <!-- Left Sidebar: Details & Stops -->
    <div class="w-full md:w-1/3 bg-card border-r border-border p-6 overflow-y-auto z-10 shadow-lg flex flex-col">
        <h2 class="text-2xl font-display font-bold text-foreground mb-4">@Model.Title</h2>

        <div class="bg-foreground/5 rounded-xl p-4 mb-6 border border-border">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-muted-foreground font-bold uppercase tracking-wider">Route</span>
                <span class="text-xs text-primary font-bold">@Math.Round(Model.TotalDistanceKm) km</span>
            </div>

            <div class="flex items-start gap-3 relative">
                <div class="flex flex-col items-center mt-1 w-4 shrink-0">
                    <div class="w-3 h-3 rounded-full bg-primary/20 border-2 border-primary"></div>
                    <div class="w-0.5 h-6 bg-border"></div>
                    <div class="w-3 h-3 rounded-full bg-white/10 border-2 border-white"></div>
                </div>
                <div class="flex-1 space-y-4">
                    <div>
                        <p class="text-sm font-bold text-foreground leading-none">@Model.StartLocation</p>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-foreground leading-none">@Model.EndLocation</p>
                    </div>
                </div>
            </div>
        </div>

        <h3 class="text-lg font-bold text-foreground mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Saved Stops
        </h3>

        <div class="flex-1 overflow-y-auto pr-2 space-y-3">
            @if(Model.Stops != null && Model.Stops.Any()) {
                @foreach (var stop in Model.Stops)
                {
                    <div class="p-3 bg-background border border-border rounded-lg flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-foreground/10 flex items-center justify-center shrink-0">
                            <!-- Basic dot, color could be dynamic based on type -->
                            <div class="w-2.5 h-2.5 rounded-full bg-primary"></div>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-bold text-foreground truncate">@stop.Name</p>
                            <p class="text-xs text-muted-foreground uppercase">@stop.Type.ToString()</p>
                        </div>
                    </div>
                }
            } else {
                <div class="p-4 border border-dashed border-border rounded-xl text-center">
                    <p class="text-sm text-muted-foreground">No stops saved for this trip.</p>
                </div>
            }
        </div>

        <!-- Add Actions at Bottom -->
        <div class="mt-auto pt-4 border-t border-border flex gap-3">
            <a href="/Trip/Create" class="flex-1 py-3 bg-primary/10 text-primary hover:bg-primary hover:text-black rounded-xl font-bold text-center transition-colors text-sm">
                Add More Stops
            </a>
            <button class="flex-1 py-3 bg-primary text-black hover:bg-primary/90 rounded-xl font-bold transition-colors text-sm shadow-[0_0_10px_rgba(24,219,103,0.3)]">
                Start Trip
            </button>
        </div>
    </div>

    <!-- Right Map Container -->
    <div class="flex-1 relative bg-muted z-0">
        <div id="modal-map" class="absolute inset-0 w-full h-full"></div>
    </div>
</div>

<script>
    // Self-executing setup since this is injected via AJAX
    (function() {
        const start = '@Model.StartLocation';
        const end = '@Model.EndLocation';

        // Deserialize C# list of stops to JS array safely
        const savedStops = @Html.Raw(JsonSerializer.Serialize(Model.Stops.Select(s => new {
            Name = s.Name,
            Lat = s.Latitude,
            Lng = s.Longitude,
            Type = s.Type.ToString()
        })));

        const mapEl = document.getElementById('modal-map');
        if(!mapEl) return;

        const isDarkMode = document.documentElement.classList.contains('dark');
        const tileUrl = isDarkMode 
            ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png' 
            : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';

        // Destroy previous instance if it exists to prevent leaflet errors
        if(window.modalMapInstance) { window.modalMapInstance.remove(); }

        const map = L.map('modal-map', { zoomControl: true }).setView([62.0, 15.0], 5);
        window.modalMapInstance = map;
        L.tileLayer(tileUrl).addTo(map);

        let routeLayer = L.layerGroup().addTo(map);
        let stopsLayer = L.layerGroup().addTo(map);

        // Map theme colors to types
        const themeColors = {
            'Fuel': '#18db67', 'Charging': '#30e5f2', 'Restaurant': '#f89e21',
            'Attraction': '#ce60f8', 'Camping': '#4d8df5', 'Lodging': '#f24694',
            'RestArea': '#ff4757', 'Default': '#18db67'
        };

        // Render Route
        async function fetchAndDrawRoute() {
            try {
                 const routeRes = await fetch(`?handler=RouteData&start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`);
                 const result = await routeRes.json();
                 
                 if (result.success && result.geometry && result.geometry.length > 0) {
                     const latLngs = result.geometry.map(p => [p.latitude, p.longitude]);
                     
                     // Draw the route line
                     L.polyline(latLngs, { color: '#18db67', weight: 6, opacity: 0.8 }).addTo(routeLayer);
                     
                     // Add start/end markers
                     const startIcon = L.divIcon({
                         className: 'bg-transparent border-0',
                         html: `<div style="color:#3b82f6; filter:drop-shadow(0 0 8px rgba(59,130,246,0.8));"><svg width="28" height="28" viewBox="0 0 24 24" fill="#0f1219" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="4" fill="currentColor"></circle></svg></div>`,
                         iconSize: [28, 28],
                         iconAnchor: [14, 14],
                         popupAnchor: [0, -14]
                     });

                     const endIcon = L.divIcon({
                         className: 'bg-transparent border-0',
                         html: `<div style="color:#ffffff; filter:drop-shadow(0 0 8px rgba(255,255,255,0.8));"><svg width="28" height="28" viewBox="0 0 24 24" fill="#0f1219" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3" fill="currentColor"></circle></svg></div>`,
                         iconSize: [28, 28],
                         iconAnchor: [14, 28],
                         popupAnchor: [0, -28]
                     });

                     L.marker(latLngs[0], { icon: startIcon }).addTo(routeLayer).bindPopup("<b>START:</b> " + start);
                     L.marker(latLngs[latLngs.length - 1], { icon: endIcon }).addTo(routeLayer).bindPopup("<b>MÅL:</b> " + end);

                     // Fit bounds to include route
                     map.fitBounds(L.polyline(latLngs).getBounds(), { padding: [50, 50] });
                 }
            } catch(e) { console.error("Error drawing route in modal", e); }
        }

        // Draw Stops
        if(savedStops && savedStops.length > 0) {
            let bounds = [];
            savedStops.forEach(s => {
                const color = themeColors[s.Type] || themeColors['Default'];
                bounds.push([s.Lat, s.Lng]);
                L.circleMarker([s.Lat, s.Lng], {
                    radius: 10,
                    color: '#ffffff',
                    fillColor: color,
                    fillOpacity: 1,
                    weight: 3
                }).addTo(stopsLayer).bindPopup(`<b>${s.Name}</b> (${s.Type})`);
            });
        }
        
        fetchAndDrawRoute();

        setTimeout(() => map.invalidateSize(), 300);
    })();
</script>