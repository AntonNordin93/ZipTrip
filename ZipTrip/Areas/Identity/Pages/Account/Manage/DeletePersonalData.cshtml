@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Permanently remove your account and all associated data</p>
    </div>

    <div class="bg-card border border-red-500/30 rounded-[24px] p-8 md:p-10 shadow-2xl relative overflow-hidden">

        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500/20 via-red-500/10 to-red-500/20"></div>

        <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-5 text-red-400 font-medium mb-8">
            <div class="flex items-center gap-3 mb-2">
                <svg class="w-6 h-6 text-red-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
                <span class="text-lg font-bold text-red-500">Warning: Irreversible Action</span>
            </div>
            <p class="text-sm text-red-400/80 ml-9">
                Deleting your data will permanently remove your account. This action cannot be undone.
                All your saved trips, preferences, and personal information will be lost forever.
            </p>
        </div>
        <form id="delete-user" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs p-3 bg-red-500/10 rounded-xl mb-4 text-center"></div>

            @if(Model.RequirePassword)
            {
                    <div class="space-y-2">
                    <label asp-for="Input.Password" class="block text-sm font-medium text-foreground">Confirm your password</label>
                    <div class="relative flex items-center text-foreground/40 focus-within:text-red-500 transition-colors">
                        <svg class="absolute left-3 w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <input asp-for="Input.Password"
                               class="w-full h-11 bg-foreground/5 border border-transparent focus:border-red-500/50 focus:bg-transparent rounded-xl pl-10 pr-4 text-sm text-foreground outline-none transition-all placeholder:text-foreground/20"
                               placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-red-500 text-[10px] ml-1 font-semibold italic tracking-wider"></span>
                    </div>
            }
            <button type="submit" class="w-full md:w-auto px-8 py-3.5 mt-6 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 text-sm shadow-lg shadow-red-900/20">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 6h18" />
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                    <line x1="10" x2="10" y1="11" y2="17" />
                    <line x1="14" x2="14" y1="11" y2="17" />
                </svg>
                Permanently Delete Account
            </button>
            </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
