@page
@model VehiclesModel
@{
    ViewData["Title"] = "My Garage";
    ViewData["ActivePage"] = ManageNavPages.Vehicles;
}
<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Manage your vehicles.</p>
    </div>
    <partial name="_StatusMessage" for="StatusMessage" />

    <!-- Desktop Grid View for Vehicles -->
    <div class="hidden md:grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        @if (!Model.UserVehicles.Any())
        {
            <div class="col-span-full py-10 border-2 border-dashed border-border/30 rounded-[24px] text-center">
                <p class="text-foreground/40 text-sm italic">You have no vehicles added to your garage.</p>
            </div>
        }
        else
        {
            @foreach (var vehicle in Model.UserVehicles)
            {
                <div class="bg-card border border-border rounded-[24px] p-6 shadow-xl relative group hover:border-primary/40 transition-all">
                    <div class="flex justify-between items-start">
                        <div class="flex items-center gap-4 cursor-pointer" onclick="window.location.href='@Url.Page("./EditVehicle", new { id = vehicle.Id })'">
                            <div class="w-10 h-10 bg-primary/10 rounded-xl flex items-center justify-center text-primary">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a2 2 0 002 2h10a2 2 0 002-2z" /></svg>
                            </div>
                            <div>
                                <h4 class="font-bold text-foreground hover:text-primary transition-colors">@vehicle.Name</h4>
                                <p class="text-[10px] text-foreground/40 font-black uppercase tracking-widest">@vehicle.VehicleType</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 relative">
                            <!-- Dropdown Menu for Vehicle Actions -->
                            <div class="relative dropdown-container">
                                <button type="button" class="vehicle-dropdown-btn p-1.5 text-foreground/50 hover:text-foreground rounded-lg hover:bg-muted transition-colors rounded-full" aria-label="Vehicle options">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/></svg>
                                </button>
                                <div class="vehicle-dropdown-menu hidden absolute right-0 top-full mt-2 w-48 bg-card border border-border rounded-xl shadow-xl overflow-hidden z-20">
                                    <div class="py-1">
                                        <a href="@Url.Page("./EditVehicle", new { id = vehicle.Id })" class="flex items-center gap-2 px-4 py-2 text-sm text-foreground hover:bg-muted w-full text-left">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                            Edit Vehicle
                                        </a>
                                        @if (!vehicle.IsDefault)
                                        {
                                            <form asp-page-handler="SetPrimary" asp-route-id="@vehicle.Id" method="post" class="m-0">
                                                <button type="submit" class="flex items-center gap-2 px-4 py-2 text-sm text-foreground hover:bg-muted w-full text-left">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.898 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                                                    Set as Primary
                                                </button>
                                            </form>
                                        }
                                        <div class="h-px bg-border my-1"></div>
                                        <form asp-page-handler="Delete" asp-route-id="@vehicle.Id" method="post" onsubmit="return confirm('Remove this vehicle?');" class="m-0">
                                            <button type="submit" class="flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-red-500/10 w-full text-left transition-colors">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (vehicle.IsDefault)
                    {
                        <span class="absolute bottom-4 right-6 text-[9px] font-black text-primary uppercase tracking-tighter bg-primary/10 px-2 py-0.5 rounded">Primary Vehicle</span>
                    }
                </div>
            }
        }
    </div>

    <!-- Mobile Dropdown View for Vehicles -->
    <div class="md:hidden mb-10 w-full relative z-[20]">
        @if (!Model.UserVehicles.Any())
        {
            <div class="py-6 border-2 border-dashed border-border/30 rounded-2xl text-center">
                <p class="text-foreground/40 text-sm italic">You have no vehicles added.</p>
            </div>
        }
        else
        {
            var primaryObj = Model.UserVehicles.FirstOrDefault(v => v.IsDefault) ?? Model.UserVehicles.FirstOrDefault();
            <div class="relative dropdown-container w-full">
                <button type="button" class="vehicle-dropdown-btn w-full bg-card hover:bg-muted/50 border border-border text-foreground font-bold p-4 rounded-xl flex items-center justify-between shadow-sm transition-colors group">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-primary/10 rounded-xl flex items-center justify-center text-primary shrink-0">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a2 2 0 002 2h10a2 2 0 002-2z" /></svg>
                        </div>
                        <div class="flex flex-col text-left">
                            <span class="font-bold">@primaryObj?.Name</span>
                            @if(primaryObj?.IsDefault == true)
                            {
                                <span class="text-[9px] text-primary uppercase tracking-tighter/40">Primary Vehicle</span>
                            }
                        </div>
                    </div>
                    <svg class="w-5 h-5 transition-transform dropdown-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div class="vehicle-dropdown-menu hidden absolute left-0 right-0 top-full mt-2 bg-card border border-border rounded-xl shadow-2xl z-[100] max-h-[50vh] overflow-y-auto">
                    <div class="p-2 space-y-1">
                        @foreach(var vehicle in Model.UserVehicles)
                        {
                            <div class="flex flex-col bg-muted/30 border border-border rounded-xl p-3 gap-2">
                                <div class="flex justify-between items-center w-full">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-sm">@vehicle.Name</span>
                                        <span class="text-[10px] text-foreground/40 uppercase tracking-widest">@vehicle.VehicleType</span>
                                    </div>
                                    @if(vehicle.IsDefault)
                                    {
                                        <span class="text-[9px] font-black text-primary uppercase bg-primary/10 px-2 py-0.5 rounded">Primary</span>
                                    }
                                </div>
                                <div class="flex items-center gap-2 mt-2 pt-2 border-t border-border/50">
                                    @if (!vehicle.IsDefault)
                                    {
                                        <form asp-page-handler="SetPrimary" asp-route-id="@vehicle.Id" method="post" class="flex-1 m-0">
                                            <button type="submit" class="w-full py-1.5 px-2 bg-primary/10 text-primary text-xs font-bold rounded hover:bg-primary hover:text-[#0f1219] transition-all">Set Primary</button>
                                        </form>
                                    }
                                    <button type="button" onclick="window.location.href='@Url.Page("./EditVehicle", new { id = vehicle.Id })'" class="flex-1 py-1.5 px-2 bg-muted text-foreground text-xs font-bold rounded border border-border hover:bg-card transition-all">Edit</button>
                                    <form asp-page-handler="Delete" asp-route-id="@vehicle.Id" method="post" onsubmit="return confirm('Remove this vehicle?');" class="m-0 shrink-0">
                                        <button type="submit" class="py-1.5 px-3 bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white rounded text-xs font-bold transition-all border border-red-500/20 hover:border-transparent">Del</button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="bg-card border border-border rounded-[32px] p-8 md:p-10 shadow-2xl">
        <div class="flex items-center gap-3 mb-8">
            <div class="h-6 w-1 bg-primary rounded-full"></div>
            <h4 class="text-xl font-bold text-foreground">Add a New Vehicle</h4>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="space-y-1">
                <label class="text-xs font-bold text-foreground/40 uppercase ml-1 tracking-widest">Search Brand</label>
                <input id="api-brand-search" list="brand-options" placeholder="Search brand..." class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none transition-all" />
                <datalist id="brand-options"></datalist>
            </div>
            <div class="space-y-1">
                <label class="text-xs font-bold text-foreground/40 uppercase ml-1 tracking-widest">Select Model</label>
                <div class="relative">
                    <select id="api-model-select" disabled class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none appearance-none peer-disabled\:opacity-30">
                        <option value="">Search brand first...</option>
                    </select>
                    <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-foreground/20">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6" /></svg>
                    </div>
                </div>
            </div>
            <div class="space-y-1">
                <label class="text-xs font-bold text-foreground/40 uppercase ml-1 tracking-widest">Year</label>
                <input id="api-year-search" type="number" placeholder="2024" min="1950" max="2026" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none transition-all" />
            </div>
        </div>

        <form method="post" class="space-y-6 pt-6 border-t border-border/20">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs italic"></div>

            <input type="hidden" asp-for="Input.Brand" id="hidden-brand" />
            <input type="hidden" asp-for="Input.Model" id="hidden-model" />
            <input type="hidden" asp-for="Input.Year" id="hidden-year" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label asp-for="Input.Name" class="text-sm font-medium ml-1 text-foreground"></label>
                    <input asp-for="Input.Name" id="res-nickname" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 outline-none transition-all" placeholder="ex. My Car" />
                    <span asp-validation-for="Input.Name" class="text-primary text-[10px]"></span>
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.SelectedVehicleType" class="text-sm font-medium ml-1 text-foreground"></label>
                    <div class="relative">
                        <select asp-for="Input.SelectedVehicleType" id="res-type" asp-items="Html.GetEnumSelectList<ZipTrip.Domain.Enums.VehicleType>()" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none appearance-none cursor-pointer"></select>
                        <div class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-foreground/20">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m6 9 6 6 6-6" /></svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
                <div class="space-y-1">
                    <label asp-for="Input.MaxHeightMeters" class="text-xs font-bold text-foreground/40 uppercase ml-1"></label>
                    <input asp-for="Input.MaxHeightMeters" id="res-height" type="number" step="0.01" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none transition-all" placeholder="0.00" />
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.MaxWeightKg" class="text-xs font-bold text-foreground/40 uppercase ml-1"></label>
                    <input asp-for="Input.MaxWeightKg" id="res-weight" type="number" step="1" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none transition-all" placeholder="0.00" />
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.RangeKm" class="text-xs font-bold text-foreground/40 uppercase ml-1"></label>
                    <input asp-for="Input.RangeKm" id="res-range" type="number" step="1" class="w-full h-12 bg-foreground/5 border-transparent focus:border-primary rounded-xl px-4 text-sm outline-none transition-all" placeholder="0.00" />
                </div>
                <div class="flex items-center gap-3 px-2 mt-4 cursor-pointer-group">
                    <div class="relative flex items-center">
                        <input type="checkbox" asp-for="Input.IsDefault"
                               class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border border-primary/30 bg-foreground/5 checked:bg-primary checked:border-primary transition-all" />
                        <svg class="absolute h-3.5 w-3.5 pointer-events-none hidden peer-checked:block stroke-[#0f1219] left-0.5 top-0.5"
                             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <label asp-for="Input.IsDefault" class="text-sm font-bold text-foreground/60 group-hover:text-primary transition-colors cursor-pointer uppercase tracking-widest text-[10px]">
                        Set as primary vehicle
                    </label>
                </div>
            </div>

            <button type="submit" class="w-full py-4 bg-primary text-[#0f1219] font-black rounded-xl hover:opacity-90 hover:scale-[1.01] active:scale-95 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2 mt-4 uppercase tracking-wider text-sm">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" /></svg>
                Add to Garage
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vehicleManagement.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const dropdownBtns = document.querySelectorAll('.vehicle-dropdown-btn');
            
            dropdownBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    
                    // Close all other dropdowns first
                    document.querySelectorAll('.vehicle-dropdown-menu').forEach(menu => {
                        if (menu !== btn.nextElementSibling) {
                            menu.classList.add('hidden');
                        }
                    });
                    
                    document.querySelectorAll('.dropdown-chevron').forEach(chevron => {
                        if (chevron.closest('.dropdown-container') !== btn.closest('.dropdown-container')) {
                            chevron.style.transform = "rotate(0deg)";
                        }
                    });

                    // Toggle this dropdown
                    const menu = btn.nextElementSibling;
                    const chevron = btn.querySelector('.dropdown-chevron');
                    
                    if (menu) {
                        const isHidden = menu.classList.contains('hidden');
                        if(isHidden) {
                            menu.classList.remove('hidden');
                            if(chevron) chevron.style.transform = "rotate(180deg)";
                        } else {
                            menu.classList.add('hidden');
                            if(chevron) chevron.style.transform = "rotate(0deg)";
                        }
                    }
                });
            });
            
            // Close dropdowns when clicking outside
            document.addEventListener('click', (e) => {
                document.querySelectorAll('.vehicle-dropdown-menu').forEach(menu => {
                    // check if not clicking inside the menu
                    if(!menu.contains(e.target)) {
                         menu.classList.add('hidden');
                    }
                });
                
                document.querySelectorAll('.dropdown-chevron').forEach(chevron => {
                    if(!chevron.closest('.dropdown-container').contains(e.target)) {
                        chevron.style.transform = "rotate(0deg)";
                    }
                });
            });
        });
    </script>
}

