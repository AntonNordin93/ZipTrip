@page
@model ZipTrip.Areas.Identity.Pages.Account.Manage.TripsModel
@{
    ViewData["Title"] = "My Trips";
    ViewData["ActivePage"] = ManageNavPages.Trips;
}

<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Manage your planned routes and saved stops.</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="bg-card border border-border rounded-[32px] p-8 md:p-10 shadow-2xl">
        <div class="flex flex-col xl:flex-row items-start xl:items-center justify-between mb-8 gap-5">
            <div class="flex items-center gap-3 shrink-0">
                <div class="h-6 w-1 bg-primary rounded-full"></div>
                <h4 class="text-xl font-bold text-foreground">Saved Trips</h4>
            </div>
            
            <!-- Filters & Search Form -->
            <form method="get" id="trips-filter-form" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full xl:justify-end xl:w-auto flex-1 max-w-2xl">
                <div class="relative flex-1 min-w-[250px] w-full">
                    <svg class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <input type="text" name="SearchQuery" value="@Model.SearchQuery" id="searchInput" placeholder="Search trips, cities..." class="w-full bg-background border border-border text-foreground text-sm rounded-xl focus:ring-primary focus:border-primary block pl-10 p-3 md:p-2.5 transition-all box-border outline-offset-[-2px] focus-visible:outline-none focus:ring-1"/>
                </div>

                <select name="SortOrder" class="w-full sm:w-auto min-w-[160px] bg-background border border-border text-foreground text-sm rounded-xl focus:ring-primary focus:border-primary block p-3 md:p-2.5 outline-offset-[-2px] focus-visible:outline-none focus:ring-1" onchange="document.getElementById('trips-filter-form').submit()">
                    <option value="newest" selected="@(Model.SortOrder == "newest")">Newest First</option>
                    <option value="oldest" selected="@(Model.SortOrder == "oldest")">Oldest First</option>
                    <option value="distance" selected="@(Model.SortOrder == "distance")">Longest Distance</option>
                </select>
                
                @if(!string.IsNullOrEmpty(Model.SearchQuery)) 
                {
                    <a href="/Identity/Account/Manage/Trips" class="text-sm px-2 text-muted-foreground hover:text-foreground underline shrink-0 hidden sm:block">Clear</a>
                }
            </form>

            <a href="/Trip/Create" class="w-full px-5 py-3 md:py-2.5 bg-primary/10 text-primary hover:bg-primary hover:text-[#0f1219] font-bold rounded-xl text-sm transition-all shadow-[0_0_10px_rgba(24,219,103,0.1)] hover:shadow-[0_0_15px_rgba(24,219,103,0.3)] shrink-0 whitespace-nowrap text-center xl:w-auto hidden xl:block">
                + New Trip
            </a>

            <!-- Mobile specific clear/new button row -->
            <div class="flex flex-col items-stretch w-full xl:hidden gap-3">
               @if(!string.IsNullOrEmpty(Model.SearchQuery)) 
                {
                    <a href="/Identity/Account/Manage/Trips" class="w-full text-sm px-3 py-2 border border-border rounded-xl text-muted-foreground hover:bg-foreground/5 hover:text-foreground text-center">Clear Search</a>
                }
                 <a href="/Trip/Create" class="w-full px-5 py-2.5 bg-primary/10 text-primary hover:bg-primary hover:text-[#0f1219] font-bold rounded-xl text-sm transition-all text-center">
                    + New Trip
                </a>
            </div>
        </div>
    
        @if (Model.Trips.Any())
        {
            <div class="grid gap-4">
                @foreach (var trip in Model.Trips)
                {
                    <div class="group relative flex flex-col md:flex-row items-center justify-between p-5 rounded-2xl border border-border hover:border-primary/50 bg-foreground/5 hover:bg-foreground/10 transition-all overflow-hidden">

                        <div class="flex-1 flex items-center gap-5 w-full mb-4 md:mb-0">
                            <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 shadow-inner">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 22l10-3 10 3L12 2z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h5 class="text-lg font-bold text-foreground truncate block w-full pr-4 text-left">@trip.Title</h5>
                                <div class="flex items-center gap-2 text-xs text-foreground/60 w-full truncate mt-1">
                                    <span class="truncate">@trip.StartLocation</span>
                                    <svg class="w-3 h-3 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    <span class="truncate">@trip.EndLocation</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 shrink-0 self-end md:self-auto w-full md:w-auto justify-end">
                            <a href="/Trip/Details?id=@trip.Id" class="px-4 py-2 bg-foreground/10 hover:bg-foreground/20 text-foreground text-sm font-bold rounded-xl transition-colors">
                                View
                            </a>
    
                            <form method="post" asp-page-handler="Delete" class="m-0" onsubmit="return confirm('Are you sure you want to delete this trip?');">
                                <input type="hidden" name="id" value="@trip.Id" />
                                <button type="submit" class="p-2 bg-destructive/10 hover:bg-destructive text-destructive hover:text-white rounded-xl transition-all" title="Delete Trip">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12 px-4 border-2 border-dashed border-border rounded-2xl bg-foreground/5">
                <svg class="w-12 h-12 text-muted-foreground mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 22l10-3 10 3L12 2z"></path></svg>
                <p class="text-foreground/80 font-medium mb-1">No trips planned yet</p>
                <p class="text-sm border-transparent/60 text-muted-foreground">Start your journey by creating a new route.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/trips-manage.js" asp-append-version="true"></script>
}
