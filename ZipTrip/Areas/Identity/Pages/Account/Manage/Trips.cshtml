@page
@model ZipTrip.Areas.Identity.Pages.Account.Manage.TripsModel
@{
    ViewData["Title"] = "My Trips";
    ViewData["ActivePage"] = ManageNavPages.Trips;
}

<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Manage your planned routes and saved stops.</p>
    </div>

    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="bg-card border border-border rounded-[32px] p-8 md:p-10 shadow-2xl">
        <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-3">
                <div class="h-6 w-1 bg-primary rounded-full"></div>
                <h4 class="text-xl font-bold text-foreground">Saved Trips</h4>
            </div>
            <a href="/Trip/Create" class="px-5 py-2.5 bg-primary/10 text-primary hover:bg-primary hover:text-[#0f1219] font-bold rounded-xl text-sm transition-all shadow-[0_0_10px_rgba(24,219,103,0.1)] hover:shadow-[0_0_15px_rgba(24,219,103,0.3)]">
                + New Trip
            </a>
        </div>
    
        @if (Model.Trips.Any())
        {
            <div class="grid gap-4">
                @foreach (var trip in Model.Trips)
                {
                    <div class="group relative flex flex-col md:flex-row items-center justify-between p-5 rounded-2xl border border-border hover:border-primary/50 bg-foreground/5 hover:bg-foreground/10 transition-all overflow-hidden">

                        <div class="flex-1 flex items-center gap-5 w-full mb-4 md:mb-0">
                            <div class="w-12 h-12 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0 shadow-inner">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 22l10-3 10 3L12 2z"></path></svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h5 class="text-lg font-bold text-foreground truncate block w-full pr-4 text-left">@trip.Title</h5>
                                <div class="flex items-center gap-2 text-xs text-foreground/60 w-full truncate mt-1">
                                    <span class="truncate">@trip.StartLocation</span>
                                    <svg class="w-3 h-3 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    <span class="truncate">@trip.EndLocation</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 shrink-0 self-end md:self-auto w-full md:w-auto justify-end">
                            <button type="button" 
                                    data-trip-id="@trip.Id" 
                                    class="view-trip-btn px-4 py-2 bg-foreground/10 hover:bg-foreground/20 text-foreground text-sm font-bold rounded-xl transition-colors">
                                View
                            </button>
    
                            <form method="post" asp-page-handler="Delete" class="m-0" onsubmit="return confirm('Are you sure you want to delete this trip?');">
                                <input type="hidden" name="id" value="@trip.Id" />
                                <button type="submit" class="p-2 bg-destructive/10 hover:bg-destructive text-destructive hover:text-white rounded-xl transition-all" title="Delete Trip">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12 px-4 border-2 border-dashed border-border rounded-2xl bg-foreground/5">
                <svg class="w-12 h-12 text-muted-foreground mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L2 22l10-3 10 3L12 2z"></path></svg>
                <p class="text-foreground/80 font-medium mb-1">No trips planned yet</p>
                <p class="text-sm border-transparent/60 text-muted-foreground">Start your journey by creating a new route.</p>
            </div>
        }
    </div>
</div>

<!-- Modal Container for Partial View -->
<div id="trip-modal" class="fixed inset-0 z-50 hidden bg-background/90 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-card w-full max-w-5xl h-[85vh] rounded-[32px] shadow-2xl flex flex-col overflow-hidden relative border border-border">
        <!-- Close Button -->
        <button id="close-modal-btn" class="absolute top-4 right-4 z-50 w-10 h-10 bg-background/50 hover:bg-destructive text-foreground hover:text-white rounded-full flex items-center justify-center transition-colors shadow">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
        <!-- Content injected here -->
        <div id="modal-content" class="w-full h-full flex flex-col md:flex-row">
            <div class="flex items-center justify-center w-full h-full">
                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("trip-modal");
            const modalContent = document.getElementById("modal-content");
            const closeBtn = document.getElementById("close-modal-btn");

            document.querySelectorAll(".view-trip-btn").forEach(btn => {
                btn.addEventListener("click", async function (e) {
                    const tripId = this.getAttribute("data-trip-id");
                    
                    // Show modal with loading state
                    modalContent.innerHTML = '<div class="flex items-center justify-center w-full h-full"><div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary"></div></div>';
                    modal.classList.remove("hidden");
                    document.body.style.overflow = "hidden"; // Prevent background scrolling

                    try {
                        const response = await fetch(`?handler=TripDetails&id=${tripId}`);
                        if(response.ok) {
                            const html = await response.text();
                            modalContent.innerHTML = html;
                            
                            // Re-initialize map if the script is loaded or fire an event
                            if(typeof initModalMap === 'function') {
                                setTimeout(initModalMap, 200);
                            } else {
                                // Fallback: dispatch custom event if scripts manage themselves
                                document.dispatchEvent(new CustomEvent('tripModalLoaded', { detail: { tripId: tripId }}));
                            }
                        } else {
                            modalContent.innerHTML = '<div class="p-8 text-center text-destructive">Failed to load trip details.</div>';
                        }
                    } catch (error) {
                        modalContent.innerHTML = '<div class="p-8 text-center text-destructive">Network error occurred.</div>';
                    }
                });
            });

            closeBtn.addEventListener("click", () => {
                modal.classList.add("hidden");
                document.body.style.overflow = "auto";
                modalContent.innerHTML = ""; // Clear content to destroy map instances
            });
        });
    </script>
}
