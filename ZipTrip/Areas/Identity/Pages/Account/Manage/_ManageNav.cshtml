@inject SignInManager<User> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<ul class="flex flex-col gap-2 p-0 m-0 list-none">
    <li>
        <a id="profile"
            asp-page="./Index"
            class="flex items-center gap-3 rounded-xl px-4 py-3 font-medium transition-all @(ManageNavPages.IndexNavClass(ViewContext)=="active"?"bg-primary text-[#0f1219]":"text-foreground/60 hover:bg-foreground/5 hover:text-foreground")">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
            Profile
        </a>
    </li>
    <li>
        <a id="vehicles" asp-page="./Vehicles" class="flex items-center gap-3 rounded-xl px-4 py-3 font-medium transition-all @(ManageNavPages.VehiclesNavClass(ViewContext)=="active"?"bg-primary text-[#0f1219]":"text-foreground/60 hover:bg-foreground/5 hover:text-foreground")">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-1.1 0-2 .9-2 2v7c0 1.1.9 2 2 2h2" />
                <circle cx="7" cy="17" r="2" />
                <path d="M9 17h6" />
                <circle cx="17" cy="17" r="2" />
            </svg>
            Vehicles
        </a>
    </li>
    <li>
        <a id="trips" asp-page="./Trips" class="flex items-center gap-3 rounded-xl px-4 py-3 font-medium transition-all @(ManageNavPages.TripsNavClass(ViewContext)=="active"?"bg-primary text-[#0f1219]":"text-foreground/60 hover:bg-foreground/5 hover:text-foreground")">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            Trips
        </a>
    </li>
    <li>
        <a id="change-password"
            asp-page="./ChangePassword"
            class="flex items-center gap-3 rounded-xl px-4 py-3 font-medium transition-all @(ManageNavPages.ChangePasswordNavClass(ViewContext)=="active"?"bg-primary text-[#0f1219]":"text-foreground/60 hover:bg-foreground/5 hover:text-foreground")">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
            Change Password
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li>
            <a id="external-logins"
                asp-page="./ExternalLogins"
                class="flex items-center gap-3 rounded-xl px-4 py-3 font-medium transition-all @(ManageNavPages.ExternalLoginsNavClass(ViewContext)=="active"?"bg-primary text-[#0f1219]":"text-foreground/60 hover:bg-foreground/5 hover:text-foreground")">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><polyline points="10 17 15 12 10 7" /><line x1="15" x2="3" y1="12" y2="12" /></svg>
                External Logins
            </a>
        </li>
    }

    <li>
        <a id="personal-data"
            asp-page="./PersonalData"
            class="flex items-center gap-3 rounded-xl px-4 py-3 font-medium transition-all @(ManageNavPages.PersonalDataNavClass(ViewContext)=="active"?"bg-primary text-[#0f1219]":"text-foreground/60 hover:bg-foreground/5 hover:text-foreground")">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" x2="12" y1="15" y2="3" /></svg>
            Personal Data
        </a>
    </li>
    <li class="mt-4">
        <a href="/" class="w-full flex items-center justify-center gap-2 rounded-xl px-4 py-3 font-bold transition-all bg-primary text-[#0f1219] hover:opacity-90 hover:scale-[1.02]">
            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Back To Home
        </a>
    </li>
</ul>
