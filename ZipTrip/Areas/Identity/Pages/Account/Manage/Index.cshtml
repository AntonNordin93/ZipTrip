@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Manage your personal information.</p>
    </div>
    <partial name="_StatusMessage" for="StatusMessage" />
    <div class="bg-card border border-border rounded-[24px] p-8 md:p-10 shadow-2xl">
        <form id="profile-form" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs p-3 bg-red-500/10 rounded-xl mb-4 text-center"></div>

            <div class="space-y-1">
                <label asp-for="Username" class="block text-sm font-medium text-foreground">Username (Email)</label>
                <div class="relative flex items-center">
                    <svg class="absolute left-3 text-foreground/40 w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                    <input asp-for="Username" class="w-full h-11 bg-foreground/5 border border-transparent rounded-xl pl-10 pr-4 text-sm text-foreground/50 cursor-not-allowed" disabled />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label asp-for="Input.FirstName" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.FirstName" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                    <span asp-validation-for="Input.FirstName" class="text-primary text-[10px] ml-1 font-semibold"></span>
                </div>
                <div class="space-y-1">
                    <label asp-for="Input.LastName" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.LastName" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                    <span asp-validation-for="Input.LastName" class="text-primary text-[10px] ml-1 font-semibold"></span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label asp-for="Input.PhoneNumber" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.PhoneNumber" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-primary text-[10px] ml-1 font-semibold"></span>
                </div>
            
                <div class="space-y-1">
                    <label asp-for="Input.DateOfBirth" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.DateOfBirth" type="date" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                    <span asp-validation-for="Input.DateOfBirth" class="text-primary text-[10px] ml-1 font-semibold"></span>
                </div>
            </div>
            <div class="flex items-center gap-4 pt-4 pb-2">
                <div class="h-[1px] flex-1 bg-border/50"></div>
                <span class="text-xs text-foreground/40 uppercase tracking-widest font-bold">Address Details</span>
                <div class="h-[1px] flex-1 bg-border/50"></div>
            </div>

            <div class="space-y-1">
                <label asp-for="Input.Address" class="block text-sm font-medium text-foreground"></label>
                <input asp-for="Input.Address" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                <span asp-validation-for="Input.Address" class="text-primary text-[10px] ml-1 font-semibold"></span>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div class="space-y-1">
                    <label asp-for="Input.PostalCode" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.PostalCode" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                </div>
                <div class="space-y-1 col-span-2 md:col-span-1">
                    <label asp-for="Input.City" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.City" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                </div>
                <div class="space-y-1 col-span-2 md:col-span-1">
                    <label asp-for="Input.Country" class="block text-sm font-medium text-foreground"></label>
                    <input asp-for="Input.Country" class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl px-3 text-sm outline-none transition-all" />
                </div>
            </div>
            <button id="update-profile-button" type="submit" class="w-full md:w-auto px-8 py-3.5 mt-6 bg-primary text-[#0f1219] font-bold rounded-xl hover:opacity-90 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 text-sm">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /><polyline points="7 3 7 8 15 8" /></svg>
                Save Changes
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
