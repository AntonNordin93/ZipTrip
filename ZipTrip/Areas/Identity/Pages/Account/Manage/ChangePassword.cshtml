@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Update your password to keep your account secure</p>
    </div>


    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="bg-card border border-border rounded-[24px] p-8 md:p-10 shadow-2xl">
        <form id="change-password-form" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-xs p-3 bg-red-500/10 rounded-xl mb-4 text-center"></div>

            <div class="space-y-1">
                <label asp-for="Input.OldPassword" class="block text-sm font-medium text-foreground">Current password</label>
                <div class="relative flex items-center text-foreground/40 focus-within:text-primary">
                    <svg class="absolute left-3 w-4 h-4 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                    </svg>
                    <input asp-for="Input.OldPassword"
                           class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl pl-10 pr-4 text-sm text-foreground outline-none transition-all placeholder:text-foreground/20"
                           placeholder="••••••••" autocomplete="current-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-primary text-[10px] ml-1 font-semibold italic tracking-wider"></span>
            </div>

            <div class="space-y-1">
                <label asp-for="Input.NewPassword" class="block text-sm font-medium text-foreground">New password</label>
                <div class="relative flex items-center text-foreground/40 focus-within:text-primary">
                    <svg class="absolute left-3 w-4 h-4 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" />
                    </svg>
                    <input asp-for="Input.NewPassword"
                           class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl pl-10 pr-4 text-sm text-foreground outline-none transition-all placeholder:text-foreground/20"
                           placeholder="••••••••" autocomplete="new-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-primary text-[10px] ml-1 font-semibold italic tracking-wider"></span>
            </div>

            <div class="space-y-1">
                <label asp-for="Input.ConfirmPassword" class="block text-sm font-medium text-foreground">Confirm new password</label>
                <div class="relative flex items-center text-foreground/40 focus-within:text-primary">
                    <svg class="absolute left-3 w-4 h-4 transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" />
                    </svg>
                    <input asp-for="Input.ConfirmPassword"
                           class="w-full h-11 bg-foreground/5 border border-transparent focus:border-primary focus:bg-transparent rounded-xl pl-10 pr-4 text-sm text-foreground outline-none transition-all placeholder:text-foreground/20"
                           placeholder="••••••••" autocomplete="new-password" aria-required="true" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-primary text-[10px] ml-1 font-semibold italic tracking-wider"></span>
            </div>
            <button type="submit" class="w-full md:w-auto px-8 py-3.5 mt-6 bg-primary text-[#0f1219] font-bold rounded-xl hover:opacity-90 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 text-sm">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                Update password
            </button>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
