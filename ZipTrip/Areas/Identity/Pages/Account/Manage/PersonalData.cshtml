@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="max-w-3xl">
    <div class="mb-8">
        <h3 class="text-3xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">@ViewData["Title"]</h3>
        <p class="text-foreground/60 text-sm mt-1">Manage your personal data</p>
    </div>

    <div class="bg-card border border-border rounded-[24px] p-8 md:p-10 shadow-2xl">
        <div class="space-y-6">
            <div class="text-sm text-foreground/80 leading-relaxed">
                <p class="mb-5">
                    Your account contains personal data that you have given us. This page allows you to download or delete that data.
                </p>
                <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 text-red-400 font-medium">
                    <div class="flex items-center gap-2 mb-1">
                        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                        Warning
                    </div>
                    Deleting this data will permanently remove your account, and this cannot be recovered.
                </div>
            </div>

            <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-border/50">
                <form id="download-data" asp-page="DownloadPersonalData" method="post" class="w-full sm:w-auto">
                    <button class="w-full px-6 py-3.5 bg-primary text-[#0f1219] font-bold rounded-xl hover:opacity-90 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 text-sm" type="submit">
                        <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="7 10 12 15 17 10" />
                            <line x1="12" x2="12" y1="15" y2="3" />
                        </svg>
                        Download Data
                    </button>
                </form>

                <a id="delete" asp-page="DeletePersonalData" class="w-full sm:w-auto px-6 py-3.5 bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white font-bold rounded-xl active:scale-95 transition-all flex items-center justify-center gap-2 text-sm">
                    <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18" />
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                        <line x1="10" x2="10" y1="11" y2="17" />
                        <line x1="14" x2="14" y1="11" y2="17" />
                    </svg>
                    Delete Account
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
