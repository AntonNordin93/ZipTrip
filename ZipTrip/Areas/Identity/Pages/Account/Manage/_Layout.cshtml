@{

    Layout = "/Pages/Shared/_Layout.cshtml";


    ViewData["HideHeader"] = true;
    ViewData["HideFooter"] = true;
}

<div class="mx-auto max-w-6xl px-4 py-6 md:py-10 md:px-8">
    <div class="mb-6 md:mb-10 flex items-center justify-between">
        <div>
            <h1 class="text-2xl md:text-4xl font-bold tracking-tight text-foreground" style="font-family: 'Sora', sans-serif;">Account Settings</h1>
            <p class="mt-1 md:mt-2 text-xs md:text-sm text-foreground/60">Manage Your Account.</p>
        </div>
        
        <!-- Mobile Navigation Toggle -->
        <button id="mobile-manage-nav-btn" class="md:hidden flex items-center justify-center p-2 rounded-xl bg-transparent border-none text-[#18db67] hover:bg-muted transition-colors">
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
    </div>

    <!-- Mobile Navigation Menu -->
    <div id="mobile-manage-nav-menu" class="hidden md:hidden fixed inset-0 z-[100] bg-background transform translate-x-full transition-transform duration-300">
        <!-- Using high z-index and removed layout issues so it covers full screen correctly without being cut off -->
        <div class="flex flex-col h-full bg-background px-6 pt-10 pb-6 relative z-[101]">
            <div class="flex justify-between items-center mb-8 border-b border-border pb-4 w-full">
                <span class="font-bold text-xl text-foreground">Menu</span>
                <button id="close-manage-nav-btn" class="text-foreground">
                    <svg class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <div id="mobile-manage-nav-container" class="flex-1 overflow-y-auto w-full">
                <!-- Navigation will be cloned here -->
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-8 md:flex-row md:gap-12">
        <aside class="hidden md:block w-full shrink-0 md:w-64" id="desktop-manage-nav">
            <partial name="_ManageNav" />
        </aside>

        <div class="flex-1 w-full max-w-full overflow-hidden">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const mobileBtn = document.getElementById('mobile-manage-nav-btn');
            const closeBtn = document.getElementById('close-manage-nav-btn');
            const mobileMenu = document.getElementById('mobile-manage-nav-menu');
            const mobileContainer = document.getElementById('mobile-manage-nav-container');
            const desktopNav = document.querySelector('#desktop-manage-nav ul');

            if (mobileBtn && closeBtn && mobileMenu && desktopNav && mobileContainer) {
                // Clone nav
                const navClone = desktopNav.cloneNode(true);
                mobileContainer.appendChild(navClone);

                const toggleMenu = () => {
                    const isOpen = !mobileMenu.classList.contains('hidden');
                    if (isOpen) {
                        mobileMenu.classList.add('translate-x-full');
                        setTimeout(() => mobileMenu.classList.add('hidden'), 300);
                        document.body.style.overflow = '';
                    } else {
                        mobileMenu.classList.remove('hidden');
                        void mobileMenu.offsetWidth;
                        mobileMenu.classList.remove('translate-x-full');
                        document.body.style.overflow = 'hidden';
                    }
                };

                mobileBtn.addEventListener('click', toggleMenu);
                closeBtn.addEventListener('click', toggleMenu);
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
}