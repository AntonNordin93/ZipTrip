<!DOCTYPE html>
<html lang="sv" class="dark"> @* Viktigt: class="dark" måste vara här *@
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - ZipTrip</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" 
          crossorigin="" />
</head>
<body class="bg-background text-foreground font-sans antialiased flex flex-col min-h-screen">

    <header class="bg-background/80 backdrop-blur-md sticky top-0 z-50 border-b border-white/10">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">
                <a asp-controller="Home" asp-action="Index" 
                   class="text-3xl font-bold tracking-tighter text-white">
                    ZIP<span class="text-primary">TRIP</span>
                </a>

                <div class="flex items-center gap-x-8 font-medium">
                    <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors text-gray-300">Hem</a>
                    <a asp-controller="Home" asp-action="Privacy" class="hover:text-primary transition-colors text-gray-300">Integritet</a>
                    <div class="flex items-center">
                         <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-1 w-full">
        @RenderBody()
    </main>

    <footer class="bg-background border-t border-white/5 mt-auto">
        <div class="max-w-7xl mx-auto py-12 px-4 text-center text-sm text-muted-foreground">
            © 2026 ZipTrip - Examensarbete Systemutveckling med AI-kompetens
        </div>
    </footer>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>