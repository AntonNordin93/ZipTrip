@page
@model IndexModel
<section class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="~/images/hero-road.jpg" class="w-full h-full object-cover" alt="Väg" />
        <div class="hero-overlay"></div>
    </div>

    <div class="relative z-10 container mx-auto px-4">
        <div class="max-w-3xl">
            <span class="text-primary font-bold tracking-widest uppercase text-sm mb-4 block">
                ⚡ Roadtrips genom Sverige
            </span>
            <h1 class="hero-title text-6xl md:text-8xl font-bold mb-6 leading-tight">
                Din resa, <br />
                <span class="text-primary">ditt fordon,</span><br />
                din väg.
            </h1>
            <p class="dark:text-gray-400 text-gray-700 text-xl mb-10 max-w-lg transition-colors">
                Planera roadtrips anpassade efter just ditt fordon. Bil, elbil eller husbil – vi fixar resten.
            </p>
            
            <a href="/Trip/Create" class="btn-primary">
                Planera din resa
            </a>
        </div>
    </div>
</section>

<section id="vehicles" class="py-20 bg-background transition-colors duration-500">
    <div class="container mx-auto px-4">
        <div class="flex justify-between items-end mb-12">
            <div>
                <h2 class="text-4xl font-bold mb-2">Välj ditt fordon</h2>
                <p class="text-muted-foreground">Anpassa din rutt efter räckvidd och fordonshöjd.</p>
            </div>
            <a href="/Account/Vehicles/Add" class="text-primary font-bold hover:underline">+ Lägg till fordon</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            @if (Model.UserVehicles != null && Model.UserVehicles.Any())
            {
                @foreach (var vehicle in Model.UserVehicles)
                {
                    <div class="p-8 rounded-[2rem] bg-card border border-border hover:border-primary/50 transition-all cursor-pointer group">
                        <div class="text-4xl mb-6 group-hover:scale-110 transition-transform">
                            @(vehicle.VehicleTypeName == "ElectricCar" ? "⚡" : vehicle.VehicleTypeName == "MotorHome" ? "🚐" : "🚗")
                        </div>
                        <h3 class="text-xl font-bold">@vehicle.Name</h3>
                        <p class="text-sm text-muted-foreground mb-4">@vehicle.VehicleTypeName</p>
                        
                        <div class="flex gap-4 text-xs font-mono opacity-70">
                            <span>@vehicle.MaxRangeKm km</span>
                            <span>@vehicle.MaxHeightMeters m</span>
                        </div>
                    </div>
                }
            }
            else
            {
                @* Visar mallar om användaren är tom *@
                @foreach (var spec in Model.StandardSpecs?.Take(3) ?? new List<ZipTrip.Services.DTOs.Vehicle.VehicleResponse>())
                {
                    <div class="p-8 rounded-[2rem] border border-dashed border-border opacity-50 hover:opacity-100 transition-all">
                        <h3 class="font-bold">@spec.Name</h3>
                        <p class="text-xs">Klicka för att använda mall</p>
                    </div>
                }
            }
        </div>
    </div>
</section>