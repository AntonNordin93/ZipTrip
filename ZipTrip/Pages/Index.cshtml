@page
@model IndexModel
@{
    ViewData["Title"] = "Hem - ZipTrip";
}

<div class="max-w-7xl mx-auto px-4 py-10">
    <div class="text-center mb-12">
        <h1 class="text-5xl md:text-6xl font-bold tracking-tighter text-gray-900 dark:text-white">
            Upptäck Sverige på vägen
        </h1>
        <p class="mt-6 text-xl text-gray-600 dark:text-gray-400">
            Planera roadtrips anpassade för vanlig bil, elbil eller husbil/husvagn
        </p>
    </div>
    
    <div class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl p-8 mb-10">
        <h2 class="text-2xl font-semibold mb-6">Väder just nu (Stockholm)</h2>
        
        @if (Model.CurrentWeather != null)
        {
            <div class="flex items-center gap-8">
                <div class="text-7xl">@Model.CurrentWeather.Icon</div>
                <div>
                    <p class="text-5xl font-bold">@Model.CurrentWeather.TempC</p>
                    <p class="text-xl text-gray-600 dark:text-gray-400">@Model.CurrentWeather.Description</p>
                </div>
            </div>
        }
    </div>
    
    <div class="map-container">
        <div id="map"></div>
    </div>

    <div class="mt-10 flex justify-center">
        <a href="/Trip/Create"
               class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-8 py-4 rounded-2xl text-lg transition-all">
            Skapa ny roadtrip →
        </a>
    </div>
</div>