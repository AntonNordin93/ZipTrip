@page
@model IndexModel
@{
    ViewData["Title"] = "Hem - ZipTrip";
}

<section aria-label="Introduktion" class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0">
        <img src="~/images/hero-road.jpg"
             alt="Slingrig väg genom svensk vildmark vid skymning, omgiven av tallskog"
             class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gray-900/80"></div>
    </div>

    <div class="relative container mx-auto px-4 pt-24">
        <div class="max-w-2xl">
            <span class="inline-block text-blue-500 font-bold text-sm uppercase tracking-widest mb-4">
                ⚡ Roadtrips genom Sverige
            </span>
            <h1 class="text-5xl md:text-7xl font-bold text-white leading-[1.1] mb-6">
                Din resa, <span class="text-blue-500">ditt fordon,</span> din väg.
            </h1>
            <p class="text-gray-300 text-lg md:text-xl leading-relaxed mb-8 max-w-lg">
                Planera roadtrips anpassade efter just ditt fordon. Bil, elbil eller husbil – vi fixar resten.
            </p>
            <div class="flex flex-wrap gap-4">
                <a href="/Trip/Create" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-medium px-8 py-4 rounded-2xl text-lg transition-all">
                    Planera din resa
                    <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
                <a href="#vehicles" class="inline-flex items-center justify-center border-2 border-white text-white hover:bg-white hover:text-black font-medium px-8 py-4 rounded-2xl text-lg transition-all">
                    Läs mer
                </a>
            </div>
        </div>
    </div>
</section>

<div class="max-w-7xl mx-auto px-4 py-16">
    <div class="bg-white dark:bg-zinc-900 rounded-3xl shadow-xl p-8 mb-10">
        <h2 class="text-2xl font-semibold mb-6">Väder just nu (Stockholm)</h2>
        
        @if (Model.CurrentWeather != null)
        {
            <div class="flex items-center gap-8">
                <div class="text-7xl">@Model.CurrentWeather.Icon</div>
                <div>
                    <p class="text-5xl font-bold">@Model.CurrentWeather.TempC</p>
                    <p class="text-xl text-gray-600 dark:text-gray-400">@Model.CurrentWeather.Description</p>
                </div>
            </div>
        }
    </div>
</div>