@page "{statusCode:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.HttpStatusCode switch
    {
        404 => "Sidan hittades inte - ZipTrip",
        _ => "Ett fel har inträffat - ZipTrip"
    };
}

<div class="min-h-screen bg-gray-50 dark:bg-zinc-950 flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full text-center">
        
        <!-- Stor ikon -->
        <div class="mb-10">
            @if (Model.HttpStatusCode == 404)
            {
                <span class="text-9xl">🗺️</span>
            }
            else if (Model.HttpStatusCode >= 500)
            {
                <span class="text-9xl">🚧</span>
            }
            else
            {
                <span class="text-9xl">⚠️</span>
            }
        </div>

        <h1 class="text-6xl font-bold tracking-tighter text-gray-900 dark:text-white mb-6">
            @if (Model.HttpStatusCode == 404)
            {
                <text>404</text>
            }
            else
            {
                <text>Oj!</text>
            }
        </h1>

        <h2 class="text-2xl font-semibold text-gray-700 dark:text-gray-300 mb-8">
            @if (Model.HttpStatusCode == 404)
            {
                <text>Sidan kunde inte hittas</text>
            }
            else
            {
                <text>Något gick fel på vår sida</text>
            }
        </h2>

        <p class="text-lg text-gray-600 dark:text-gray-400 mb-12 leading-relaxed">
            @Model.Message
        </p>

        @if (Model.ShowRequestId && !string.IsNullOrEmpty(Model.RequestId))
        {
            <div class="bg-white dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-3xl p-5 mb-10 text-left">
                <p class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400 mb-2">Felreferens</p>
                <code class="text-sm text-gray-700 dark:text-gray-300 break-all font-mono">
                    @Model.RequestId
                </code>
            </div>
        }

        <div class="flex flex-col gap-4">
            <a href="/"
                   class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-medium px-10 py-4 rounded-3xl text-lg transition-all active:scale-95">
                ← Tillbaka till startsidan
            </a>
            
            <button onclick="window.location.reload()"
                    class="inline-flex items-center justify-center border border-gray-300 dark:border-zinc-700 hover:bg-gray-100 dark:hover:bg-zinc-800 font-medium px-10 py-4 rounded-3xl text-lg transition-all">
                Försök igen
            </button>
        </div>

        <p class="mt-12 text-xs text-gray-400 dark:text-gray-500">
            ZipTrip © 2026 - Examensarbete
        </p>
    </div>
</div>