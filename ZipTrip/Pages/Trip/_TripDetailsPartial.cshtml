@model ZipTrip.Pages.Trip.CreateModel

<div id="details-menu" class="fade-in space-y-8 pb-10">
    <div class="border-b border-border pb-6">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-2">Trip Ready</span>
        <h1 class="text-3xl font-display font-bold text-foreground truncate" id="display-title">Resplan</h1>
        <p class="text-muted-foreground mt-2 font-medium" id="display-distance">0 km</p>
        <button type="button" onclick="window.location.reload()" class="mt-4 text-xs font-bold text-accent hover:text-white transition-colors cursor-pointer uppercase underline">← Back / Edit</button>
        
        <button type="button" id="start-gps-btn" class="mt-6 w-full bg-primary hover:bg-primary/90 text-[#0f1219] font-bold text-lg rounded-xl p-4 shadow-[0_0_20px_rgba(24,219,103,0.4)] transition-all hover:scale-105 flex justify-center items-center gap-2 cursor-pointer">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 2L2 22l10-3 10 3L12 2z"></path></svg>
            START NAVIGATION
        </button>
    </div>

    <div class="space-y-6">
        <h3 class="text-xl font-display font-bold text-foreground">Find Stops</h3>
        
        <div class="space-y-3">
            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#18db67]/10 border border-border hover:border-[#18db67] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Fuel">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#18db67] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(24,219,103,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 3v18h18"></path><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path></svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#18db67] transition-colors">Gas Stations</div>
                    <div class="text-xs text-muted-foreground">Find fuel stops</div>
                </div>
            </button>

            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#30e5f2]/10 border border-border hover:border-[#30e5f2] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Charging">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#30e5f2] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(48,229,242,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#30e5f2] transition-colors">EV Charging</div>
                    <div class="text-xs text-muted-foreground">Fast chargers along way</div>
                </div>
            </button>

            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#f89e21]/10 border border-border hover:border-[#f89e21] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Restaurant">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#f89e21] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(248,158,33,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#f89e21] transition-colors">Restaurants</div>
                    <div class="text-xs text-muted-foreground">Dining options</div>
                </div>
            </button>

            <!-- Attractions Button -->
            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#ce60f8]/10 border border-border hover:border-[#ce60f8] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Attraction">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#ce60f8] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(206,96,248,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 21l1.9-5.7a8.5 8.5 0 113.8 3.8z"></path>
                    </svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#ce60f8] transition-colors">Attractions</div>
                    <div class="text-xs text-muted-foreground">Discover scenic spots</div>
                </div>
            </button>

            <!-- Camping Button -->
            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#4d8df5]/10 border border-border hover:border-[#4d8df5] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Camping">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#4d8df5] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(77,141,245,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V9l7-6 7 6v12M9 21v-6h6v6"></path>
                    </svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#4d8df5] transition-colors">Camping</div>
                    <div class="text-xs text-muted-foreground">Campgrounds for the night</div>
                </div>
            </button>

            <!-- Lodging Button -->
            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#f24694]/10 border border-border hover:border-[#f24694] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Lodging">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#f24694] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(242,70,148,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                    </svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#f24694] transition-colors">Lodging</div>
                    <div class="text-xs text-muted-foreground">Hotels and motels</div>
                </div>
            </button>

            <!-- RestArea Button -->
            <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#eab308]/10 border border-border hover:border-[#eab308] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="RestArea">
                <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#eab308] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(234,179,8,0.2)]">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                </div>
                <div class="text-left">
                    <div class="font-bold text-foreground group-hover:text-[#eab308] transition-colors">Rest Areas</div>
                    <div class="text-xs text-muted-foreground">Take a break</div>
                </div>
            </button>
        </div>
    </div>
</div>