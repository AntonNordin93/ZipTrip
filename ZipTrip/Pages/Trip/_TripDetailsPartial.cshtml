@model ZipTrip.Pages.Trip.CreateModel

<div id="details-menu" class="transition-opacity duration-300 fade-in">
    <div class="mb-8 border-b border-border pb-6">
        <span class="text-xs font-bold text-primary uppercase tracking-widest block mb-2">Trip Ready</span>
        <h1 class="text-3xl font-display font-bold text-foreground" id="display-title">Din Resa</h1>
        <p class="text-muted-foreground mt-2" id="display-distance">Beräknar avstånd...</p>
        <button type="button" id="btn-edit-trip" class="mt-4 text-xs font-bold text-accent hover:text-white underline cursor-pointer">← Edit Trip Details</button>
    </div>

    <div class="space-y-6">
        <div>
            <h3 class="font-display text-xl font-bold text-foreground mb-2">Find Stops</h3>
            <p class="text-sm text-muted-foreground">Scan your route for essential stops.</p>
        </div>
        
        <div class="space-y-3">
            <button type="button" class="fetch-stops-btn w-full group relative bg-background rounded-xl p-4 border border-border hover:border-primary transition-colors cursor-pointer text-left flex items-center gap-4" data-type="Fuel">
                <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center text-primary text-xl">⛽</div>
                <div class="font-semibold text-sm">Gas Stations</div>
            </button>

            <button type="button" class="fetch-stops-btn w-full group relative bg-background rounded-xl p-4 border border-border hover:border-cyan-400 transition-colors cursor-pointer text-left flex items-center gap-4" data-type="Charging">
                <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center text-cyan-400 text-xl">⚡</div>
                <div class="font-semibold text-sm">EV Charging</div>
            </button>

            <button type="button" class="fetch-stops-btn w-full group relative bg-background rounded-xl p-4 border border-border hover:border-orange-400 transition-colors cursor-pointer text-left flex items-center gap-4" data-type="Restaurant">
                <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center text-orange-400 text-xl">🍴</div>
                <div class="font-semibold text-sm">Restaurants</div>
            </button>
        </div>
    </div>
</div>