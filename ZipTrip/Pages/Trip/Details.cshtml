@page
@model ZipTrip.Pages.Trip.DetailsModel
@{
    ViewData["Title"] = Model.Trip?.Title ?? "Trip Details";
    ViewData["HideFooter"] = true;
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />

<div class="flex-1 bg-background pt-24 pb-12 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 border-b border-border pb-6">
            <div>
                <span class="text-xs font-bold text-accent uppercase tracking-widest block mb-2">Trip Overview</span>
                <h1 class="text-4xl md:text-5xl font-display font-bold text-foreground">@Model.Trip?.Title</h1>
                <p class="text-muted-foreground mt-4 flex items-center gap-3 text-lg">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    @Model.Trip?.StartLocation &rarr; @Model.Trip?.EndLocation
                    <span class="opacity-30">|</span>
                    <span id="trip-distance" class="font-bold text-foreground">Beräknar...</span>
                </p>
                @if (!string.IsNullOrEmpty(Model.AIRecommendation))
                {
                    <div class="mt-4 p-4 rounded-xl border border-secondary/30 bg-secondary/5 text-sm text-foreground flex items-center gap-3">
                        <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <span>@Model.AIRecommendation</span>
                    </div>
                }
            </div>
            <div class="mt-6 md:mt-0">
                <a href="/Account/Manage/Trips" class="inline-flex items-center justify-center gap-2 rounded-lg text-sm font-bold bg-muted text-foreground hover:bg-foreground/10 h-10 px-6 border border-border transition-all">
                    &larr; Back to Garage
                </a>
            </div>
        </div>

        <div class="grid lg:grid-cols-4 gap-8">
        
            <div class="lg:col-span-1 space-y-6">
                <div>
                    <h3 class="font-display text-xl font-bold text-foreground mb-4">Find Stops</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed mb-6">Scan your route for essential stops. We´ll fint the best options along your way</p>
                </div>
                
                <div class="space-y-3">
                    <!-- Fuel Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#18db67]/10 border border-border hover:border-[#18db67] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Fuel">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#18db67] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(24,219,103,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#18db67] transition-colors">Gas Stations</div>
                            <div class="text-xs text-muted-foreground">Find fuel stops</div>
                        </div>
                    </button>

                    <!-- Charging Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#30e5f2]/10 border border-border hover:border-[#30e5f2] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Charging">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#30e5f2] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(48,229,242,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon stroke-linecap="round" stroke-linejoin="round" points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#30e5f2] transition-colors">EV Charging</div>
                            <div class="text-xs text-muted-foreground">Fast chargers along route</div>
                        </div>
                    </button>

                    <!-- Restaurant Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#f89e21]/10 border border-border hover:border-[#f89e21] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Restaurant">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#f89e21] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(248,158,33,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path stroke-linecap="round" stroke-linejoin="round" d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path><line x1="6" y1="1" x2="6" y2="4"></line><line x1="10" y1="1" x2="10" y2="4"></line><line x1="14" y1="1" x2="14" y2="4"></line></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#f89e21] transition-colors">Restaurants</div>
                            <div class="text-xs text-muted-foreground">Places to eat</div>
                        </div>
                    </button>

                    <!-- Attractions Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#ce60f8]/10 border border-border hover:border-[#ce60f8] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Attraction">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#ce60f8] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(206,96,248,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polygon stroke-linecap="round" stroke-linejoin="round" points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#ce60f8] transition-colors">Attractions</div>
                            <div class="text-xs text-muted-foreground">Discover scenic spots</div>
                        </div>
                    </button>

                    <!-- Camping Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#4d8df5]/10 border border-border hover:border-[#4d8df5] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Camping">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#4d8df5] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(77,141,245,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 22h20L12 2z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 12l-4 10"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 12l4 10"></path></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#4d8df5] transition-colors">Camping</div>
                            <div class="text-xs text-muted-foreground">Campgrounds for the night</div>
                        </div>
                    </button>

                    <!-- Lodging Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#f24694]/10 border border-border hover:border-[#f24694] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="Lodging">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#f24694] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(242,70,148,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline stroke-linecap="round" stroke-linejoin="round" points="9 22 9 12 15 12 15 22"></polyline></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#f24694] transition-colors">Lodging</div>
                            <div class="text-xs text-muted-foreground">Hotels and motels</div>
                        </div>
                    </button>

                    <!-- RestArea Button -->
                    <button type="button" class="fetch-stops-btn group w-full bg-muted/30 hover:bg-[#eab308]/10 border border-border hover:border-[#eab308] rounded-2xl p-4 transition-all duration-300 flex items-center gap-4 cursor-pointer" data-type="RestArea">
                        <div class="w-12 h-12 rounded-xl bg-card flex items-center justify-center text-[#eab308] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(234,179,8,0.3)] shrink-0">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12V6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M9 12V6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16"></path><path stroke-linecap="round" stroke-linejoin="round" d="M5 12c0 3.866 3.134 7 7 7s7-3.134 7-7"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 19v3"></path><path stroke-linecap="round" stroke-linejoin="round" d="M8 22h8"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 6c-1.5 0-1.5-2-1.5-2s-1.5 2-1.5 2 1.5 2 1.5 2 1.5-2 1.5-2z"></path></svg>
                        </div>
                        <div class="text-left flex-1">
                            <div class="font-bold text-foreground group-hover:text-[#eab308] transition-colors">Rest Areas</div>
                            <div class="text-xs text-muted-foreground">Take a break</div>
                        </div>
                    </button>
                </div>
            </div>

            <div class="lg:col-span-3 relative h-[60vh] rounded-[24px] overflow-hidden border border-border shadow-2xl z-0">
                <div id="trip-map" class="w-full h-full" style="min-height:600px" data-start="@Model.Trip?.StartLocation" data-end="@Model.Trip?.EndLocation"></div>

                <div id="loading-spinner" class="absolute top-6 right-6 z-[1000] bg-card/90 backdrop-blur-md border border-primary/50 px-5 py-3 rounded-xl text-sm font-bold text-primary shadow-[0_0_15px_rgba(31,214,85,0.2)] hidden items-center gap-3">
                    <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Scanning Route...
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/trip-details.js" asp-append-version="true"></script>
}

