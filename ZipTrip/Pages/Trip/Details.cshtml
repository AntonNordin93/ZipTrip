@page
@model ZipTrip.Pages.Trip.DetailsModel
@{
    ViewData["Title"] = Model.Trip?.Title ?? "Trip Details";
    ViewData["HideFooter"] = true;
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css" />

<div class="flex-1 bg-background pt-24 pb-12 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 border-b border-border pb-6">
            <div>
                <span class="text-xs font-bold text-accent uppercase tracking-widest block mb-2">Trip Overview</span>
                <h1 class="text-4xl md:text-5xl font-display font-bold text-foreground">@Model.Trip?.Title</h1>
                <p class="text-muted-foreground mt-4 flex items-center gap-3 text-lg">
                    <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    @Model.Trip?.StartLocation &rarr; @Model.Trip?.EndLocation
                    <span class="opacity-30">|</span>
                    <span id="trip-distance" class="font-bold text-foreground">Beräknar...</span>
                </p>
            </div>
            <div class="mt-6 md:mt-0">
                <a href="/Account/Manage/Trips" class="inline-flex items-center justify-center gap-2 rounded-lg text-sm font-bold bg-muted text-foreground hover:bg-foreground/10 h-10 px-6 border border-border transition-all">
                    &larr; Back to Garage
                </a>
            </div>
        </div>

        <div class="grid lg:grid-cols-4 gap-8">
        
            <div class="lg:col-span-1 space-y-6">
                <div>
                    <h3 class="font-display text-xl font-bold text-foreground mb-4">Find Stops</h3>
                    <p class="text-sm text-muted-foreground leading-relaxed mb-6">Scan your route for essential stops. We´ll fint the best options along your way</p>
                </div>
                
                <div class="space-y-3">
                    <button type="button" class="fetch-stops-btn w-full group relative bg-card rounded-xl p-4 border border-border hover:border-primary/50 transition-colors duration-200 cursor-pointer text-left flex items-center gap-4" data-type="Fuel">
                        <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-neon-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18"></path><path stroke-linecap="round" stroke-linejoin="round" d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path></svg>
                        </div>
                        <div>
                            <div class="font-semibold text-foreground text-sm">Gas Stations</div>
                            <div class="text-xs text-muted-foreground">Find Fuel Stops</div>
                        </div>
                    </button>

                    <button type="button" class="fetch-stops-btn w-full group relative bg-card rounded-xl p-4 border border-border hover:border-neon-cyan/50 transition-colors duration-200 cursor-pointer text-left flex items-center gap-4" data-type="Charging">
                        <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-neon-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polygon stroke-linejoin="round" points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                        </div>
                        <div>
                            <div class="font-semibold text-foreground text-sm">EV Charging</div>
                            <div class="text-xs text-muted-foreground">Fast charging along the route</div>
                        </div>
                    </button>

                    <button type="button" class="fetch-stops-btn w-full group relative bg-card rounded-xl p-4 border border-border hover:border-neon-orange/50 transition-colors duration-200 cursor-pointer text-left flex items-center gap-4" data-type="Restaurant">
                        <div class="w-10 h-10 rounded-lg bg-muted flex items-center justify-center flex-shrink-0">
                            <svg class="w-5 h-5 text-neon-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        </div>
                        <div>
                            <div class="font-semibold text-foreground text-sm">Restaurants</div>
                            <div class="text-xs text-muted-foreground">Places to eat</div>
                        </div>
                    </button>
                </div>
            </div>

            <div class="lg:col-span-3 relative h-[60vh] rounded-[24px] overflow-hidden border border-border shadow-2xl z-0">
                <div id="trip-map" class="w-full h-full" style="min-height:600px" data-start="@Model.Trip?.StartLocation" data-end="@Model.Trip?.EndLocation"></div>

                <div id="loading-spinner" class="absolute top-6 right-6 z-[1000] bg-card/90 backdrop-blur-md border border-primary/50 px-5 py-3 rounded-xl text-sm font-bold text-primary shadow-[0_0_15px_rgba(31,214,85,0.2)] hidden items-center gap-3">
                    <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    Scanning Route...
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/trip-details.js" asp-append-version="true"></script>
}

