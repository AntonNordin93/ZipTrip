@model ZipTrip.Pages.Trip.CreateModel

<div id="create-menu" class="transition-opacity duration-300 fade-in flex flex-col h-full">
    <div class="mb-4">
        <a href="/" class="inline-flex items-center gap-2 text-xs font-bold text-muted-foreground hover:text-foreground transition-colors group">
            <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to home
        </a>
    </div>
    <div class="mb-8 relative">
        <span class="text-xs font-bold text-accent uppercase tracking-widest">New Adventure</span>
        <h1 class="text-3xl font-display font-bold text-foreground">Plan Your Route</h1>
    </div>
    
    <form method="post" id="trip-create-form" class="space-y-6">
        <div>
            <label asp-for="Input.Title" class="block text-xs font-bold text-muted-foreground mb-1 uppercase tracking-wider">Trip Title</label>
            <input asp-for="Input.Title" class="w-full bg-background border border-input rounded-xl px-4 py-2.5 text-sm text-foreground focus:ring-primary focus:outline-none transition-all" placeholder="Summer Vacation 2026" />
        </div>

        <div class="space-y-4">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-[#3b82f6]/10 border border-[#3b82f6]/30 flex items-center justify-center flex-shrink-0" style="color: #3b82f6; box-shadow: 0 0 10px rgba(59,130,246,0.3);">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
                </div>
                <input asp-for="Input.StartLocation" id="start-location" class="w-full bg-background border border-input rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-[#3b82f6] outline-none transition-all" placeholder="Starting Point" />
            </div>
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-white/5 border border-white/20 flex items-center justify-center flex-shrink-0 text-white shadow-[0_0_10px_rgba(255,255,255,0.1)]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3" fill="currentColor"></circle></svg>
                </div>
                <input asp-for="Input.EndLocation" id="end-location" class="w-full bg-background border border-input rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-white/50 focus:border-transparent outline-none transition-all" placeholder="Destination" />
            </div>
        </div>

        <hr class="border-border" />

        <div>
            <label asp-for="Input.VehicleType" class="block text-xs font-bold text-muted-foreground mb-1 uppercase tracking-wider">Vehicle Type</label>
            <select asp-for="Input.VehicleType" asp-items="Html.GetEnumSelectList<ZipTrip.Domain.Enums.VehicleType>()" class="w-full bg-background border border-input rounded-xl px-4 py-2.5 text-sm"></select>
        </div>

        <div class="pt-4 mt-auto">
            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 rounded-xl text-base font-bold bg-primary text-[#0f1219] hover:scale-105 h-14 shadow-[0_0_15px_hsl(150_100%_45%/0.3)] transition-all duration-200 cursor-pointer">
                Generate Trip
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
            </button>
        </div>
    </form>
</div>